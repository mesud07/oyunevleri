APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
SMS_PUBLIC_BASE_URL=
APP_TIMEZONE=Europe/Istanbul
APP_KEY=
CLI_KURUM_ID=1
ALLOW_NES_TEST_TOOLS=false

DB_HOST=db
DB_PORT=3306
DB_DATABASE=talya_db
DB_USERNAME=talya_user
DB_PASSWORD=talya_pass
MYSQL_ROOT_PASSWORD=root_pass

SESSION_NAME=talya_kids_session
SESSION_IDLE_TIMEOUT=1800
SESSION_ABSOLUTE_LIFETIME=43200
SESSION_COOKIE_LIFETIME=0
SESSION_COOKIE_SECURE=true
SESSION_LIFETIME=43200
REMEMBER_LOGIN_DAYS=30
# Canlıda boş bırakılırsa güvenli __Host-talya_remember adı otomatik kullanılır.
REMEMBER_COOKIE_NAME=
CSRF_TOKEN_NAME=talya_csrf
TRUSTED_PROXIES=127.0.0.1,::1
VELI_PORTAL_KURUM_KODU=TALYA
VELI_PORTAL_SHOW_TEST_CODE=false
MFA_ENFORCE=false
MFA_REQUIRED_ROLES=kurucu,muhasebe
MFA_STEP_UP_SECONDS=14400
MFA_ISSUER=Oyun Evleri
KEY_ROTATION_CONFIRMED=false
BACKUP_ENCRYPTION_KEY=
BACKUP_DIR=/var/backups/talya
BACKUP_RETENTION_DAYS=30
BACKUP_RESTORE_TESTED=false
STORAGE_ENCRYPTION_CONFIRMED=false

# Ogrenci gozlem raporu olusturma (OpenAI Responses API)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_CONNECT_TIMEOUT=10
OPENAI_TIMEOUT=60

# Adres yoğunluk haritası (OpenStreetMap uyumlu karo sağlayıcısı)
OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Sokak/cadde seviyesinde otomatik adres çözümleme ve Google haritası
# Maps JavaScript API ve Geocoding API etkin olmalıdır.
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=

SMS_PROVIDER=netgsm
SMS_ENABLED=false
SMS_TEST_MODE=true
SMS_TEST_PHONE=
SMS_FORCE_TO=
SMS_WEB_AUTOMATION_ENABLED=true
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_HEADER=
NETGSM_ENCODING=TR
NETGSM_FILTER=0
NETGSM_API_BASE_URL=https://api.netgsm.com.tr
NETGSM_CONNECT_TIMEOUT=10
NETGSM_TIMEOUT=30
SMS_MAX_RECIPIENTS_PER_REQUEST=1000
SMS_MAX_RETRY_COUNT=3
SMS_RETRY_DELAY_MINUTES=10
SMS_APPOINTMENT_REMINDER_ENABLED=true
SMS_APPOINTMENT_REMINDER_HOURS=24
SMS_PAYMENT_PROMISE_REMINDER_ENABLED=true
SMS_PAYMENT_PROMISE_REMINDER_HOURS=24

MYSOFT_BASE_URL=https://edocumentapi.mytest.tr
MYSOFT_CLIENT_ID=
MYSOFT_CLIENT_SECRET=
MYSOFT_TENANT_IDENTIFIER=
MYSOFT_ENVIRONMENT=test
MYSOFT_AUTO_INVOICE=false
MYSOFT_CONNECT_TIMEOUT=10
MYSOFT_TIMEOUT=45
MYSOFT_TOKEN_REFRESH_MARGIN=30

# NES birincil fatura entegratörüdür. API anahtarı ayrıca kurum ayarlarında
# şifreli olarak saklanabilir; buradaki değer sunucu düzeyi varsayılandır.
NES_BASE_URL=https://apitest.nes.com.tr
NES_API_KEY=
NES_ENVIRONMENT=test
NES_CONNECT_TIMEOUT=10
NES_TIMEOUT=45
NES_MAX_RESPONSE_BYTES=20971520
